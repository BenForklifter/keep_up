# ignore app cache folder
.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Sketch build output
sketch/build/
*.bin
*.elf
*.hex
*.map

# Secrets and local config
.env
.env.*
*.pem
*.key
secrets*

# Runtime data
*.log
*.db
*.sqlite
*.sqlite3

# Editors and OS
.vscode/*
!.vscode/tasks.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# local_asr brick: only its code is in git. The heavy parts (Python packages, Cactus
# runtime, Whistle model) already exist on the board in the local-speech-to-text
# starter app; deploy.sh copies them from there into this app on the board.
bricks/local_asr/vendor/
bricks/local_asr/service/runtime/
bricks/local_asr/service/models/*.cact

# Live text handed from the app container to the screen process (runtime only)
.screen/
